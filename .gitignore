# Quarto
/_book/
pt/_book/
en/_book/
pt/.quarto/
# stray single-file render outputs; the books render into */_book/
/en/*.html
/pt/*.html
en/.quarto/
/.quarto/
# pt/_freeze/ and en/_freeze/ are committed: CI reuses the execution cache
# and only re-runs chapters whose source changed.

# Julia
# Manifest.toml is committed so readers and CI get the exact package versions.
*.jl.cov
*.jl.mem
/docs/build/

# OS / editor
.DS_Store
.vscode/
*.swp

# PDF edition (built in CI by .github/workflows/pdf.yml): the PDFs live in
# pdf/ and their execution cache (_freeze/*/execute-results/tex.json and
# _freeze/*/figure-pdf/) is committed by CI. Intermediate figure folders are not.
*/_freeze/*/figure-latex/
*/*_files/figure-latex/
*/*_files/figure-pdf/
